HTTP_ADDR=:8080
DATABASE_URL=postgres://auction:auction_local_password@localhost:5432/auction?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL=1h
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=5
# Google OAuth Configuration (Optional - leave empty to disable Google Sign-In)
# Must match frontend VITE_GOOGLE_CLIENT_ID exactly
# Configure in Google Cloud Console with proper origins and redirect URIs
GOOGLE_CLIENT_ID=
# Cloudflare Turnstile Configuration (Required for security)
# Get your secret key from https://dash.cloudflare.com/sign-up
# For testing, you can use the dummy always-pass key: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
