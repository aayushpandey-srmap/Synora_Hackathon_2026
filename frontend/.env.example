VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws
# Google OAuth Configuration (Optional - leave empty to disable Google Sign-In)
# Must match backend GOOGLE_CLIENT_ID. Add http://localhost:5173 to Authorized JavaScript origins in Google Cloud Console.
# Format: 123456789-abcdef.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
# Cloudflare Turnstile Configuration (Required for security)
# Get your site key from https://dash.cloudflare.com/sign-up
# For testing, you can use the dummy always-pass key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
